<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <staticContent>
      <!-- Short cache lifetime so a new deploy shows up for visitors within
           minutes instead of needing a manual hard refresh. Long enough to
           still avoid re-downloading assets (some backgrounds are a few MB)
           on every single page load during normal browsing. -->
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="00:05:00" />
    </staticContent>
    <!-- Same internal-file protection as nginx.conf's "deny" blocks --
         Docker/manual-nginx deployments already get this via
         .dockerignore + nginx.conf, but a straight "copy the folder to
         the IIS site root" deploy had nothing keeping these readable-if-
         someone-guesses-the-name files out of reach. hiddenSegments
         matches by exact path segment, so this covers both a top-level
         file (eg. /Jenkinsfile) and an entire subtree (eg. /scripts/*).
         web.config itself needs no entry here -- IIS refuses to serve
         *any* web.config as static content by default, unconditionally. -->
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="Jenkinsfile" />
          <add segment="nginx.conf" />
          <add segment="scripts" />
          <add segment=".git" />
          <add segment=".dockerignore" />
          <add segment=".gitignore" />
        </hiddenSegments>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
