<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <staticContent>
      <!-- Short cache lifetime so a new deploy shows up for visitors within
           minutes instead of needing a manual hard refresh. Long enough to
           still avoid re-downloading assets (some backgrounds are a few MB)
           on every single page load during normal browsing. -->
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="00:05:00" />
    </staticContent>
  </system.webServer>
</configuration>
